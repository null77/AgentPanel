{
  "name": "agent-panel",
  "displayName": "Agent Panel",
  "description": "A dedicated panel tab for running TUI agent CLIs (Claude Code, OpenCode, and more) alongside your terminals",
  "version": "1.0.0",
  "publisher": "JamieMadill",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/null77/AgentPanel.git"
  },
  "bugs": {
    "url": "https://github.com/null77/AgentPanel/issues"
  },
  "homepage": "https://github.com/null77/AgentPanel#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude code",
    "opencode",
    "agent",
    "terminal",
    "panel"
  ],
  "galleryBanner": {
    "color": "#2B2620",
    "theme": "dark"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "agentPanel",
          "title": "Agent Panel",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "agentPanel": [
        {
          "type": "webview",
          "id": "agentPanel.terminalView",
          "name": "Agent Panel"
        }
      ]
    },
    "commands": [
      {
        "command": "agentPanel.switchAgent",
        "title": "Switch Agent",
        "category": "Agent Panel",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "agentPanel.restart",
        "title": "Restart Agent",
        "category": "Agent Panel",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agentPanel.clear",
        "title": "Clear Agent Terminal",
        "category": "Agent Panel",
        "icon": "$(clear-all)"
      },
      {
        "command": "agentPanel.focus",
        "title": "Focus Agent Panel",
        "category": "Agent Panel"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentPanel.switchAgent",
          "when": "view == agentPanel.terminalView",
          "group": "navigation@1"
        },
        {
          "command": "agentPanel.clear",
          "when": "view == agentPanel.terminalView",
          "group": "navigation@2"
        },
        {
          "command": "agentPanel.restart",
          "when": "view == agentPanel.terminalView",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Agent Panel",
      "properties": {
        "agentPanel.agents": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "markdownDescription": "Custom agents available in the Agent Panel. Entries with an `id` matching a built-in (`claude-code`, `opencode`) override that built-in. New ids extend the list.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "command"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "description": "Unique kebab-case identifier."
              },
              "label": {
                "type": "string",
                "description": "Display name shown in the Switch Agent picker and view header."
              },
              "command": {
                "type": "string",
                "description": "Binary name or absolute path. Resolved via where/which at spawn time if not absolute."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Arguments passed to the agent binary."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra environment variables merged on top of the inherited environment."
              },
              "icon": {
                "type": "string",
                "description": "Optional codicon id (e.g. \"sparkle\") shown in the picker."
              }
            }
          }
        },
        "agentPanel.defaultAgent": {
          "type": "string",
          "default": "claude-code",
          "scope": "window",
          "description": "Agent id launched on first open when no previous selection exists."
        },
        "agentPanel.hiddenBuiltins": {
          "type": "array",
          "default": [],
          "scope": "window",
          "items": {
            "type": "string",
            "enum": [
              "claude-code",
              "opencode"
            ]
          },
          "description": "Built-in agent ids to hide from the Switch Agent picker."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build:production": "node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "package": "vsce package",
    "publish": "vsce publish",
    "vscode:prepublish": "npm run typecheck && npm run build:production"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
